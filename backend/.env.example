# ==============================================================================
# YolaBot Backend Environment Configuration
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# Database Persistence (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yolabot_db?schema=public

# In-Memory Cache & Rate Limiting (Redis 7+)
REDIS_URL=redis://localhost:6379/0

# Security & Session Management (Minimal 32 Karakter)
SESSION_SECRET=super_secret_cryptographic_random_string_min_32_chars_dev_only

# Primary AI Provider (groq / gemini / openai / mock)
AI_PRIMARY_PROVIDER=groq

# Groq Cloud LPU
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Secondary / Fallback AI Provider (gemini / openai / mock)
AI_FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# OpenAI Configuration (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_min_32_chars

# Transactional Email (Resend / SMTP)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=YolaBot <no-reply@yolabot.local>
